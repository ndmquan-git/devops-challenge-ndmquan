# Example values only: 123456789012 is not a real account and every name is a placeholder.
github_owner = "example-owner"
github_repo  = "example-repo"

# Required for a repository created after 2026-07-15 or opted in to immutable subject
# claims (`gh api repos/<owner>/<repo> --jq '{owner_id: .owner.id, repo_id: .id}'`).
# Leave both null for a repository that still emits the name-only format.
github_owner_id = 123456
github_repo_id  = 456789

aws_region            = "us-east-1"
app_tag               = "p4-backend"
ecr_repository_name   = "p4-backend"
create_ecr_repository = true

# Separate accounts: the account that holds the repository lists the other one;
# the other names the holder and creates no repository.
# ecr_pull_account_ids  = ["210987654321"]   # in the holding account
# ecr_account_id        = "123456789012"     # in the other account
# create_ecr_repository = false              # in the other account

environments = {
  staging = {
    target_group_arn           = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/example-staging/0123456789abcdef"
    frontend_bucket            = "example-frontend-staging"
    cloudfront_distribution_id = "E1EXAMPLESTAGIN"
  }
  production = {
    target_group_arn           = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/example-production/0123456789abcdef"
    frontend_bucket            = "example-frontend-production"
    cloudfront_distribution_id = "E1EXAMPLEPROD00"
  }
}
